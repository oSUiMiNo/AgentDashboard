# Rust
/server/target/

# 配布物の置き場所。dist はリポジトリのルートを基準にするので、cargo の target とは
# 別の場所へ出る（`scripts/dist build`）
/target/

# 自己修復（設計§9）の作業場所。修復セッション用の git worktree とビルド成果物を置く。
# リポジトリの外に置けないのは、cargo がコンテナの中で動いており、
# scripts/cargo がリポジトリだけをマウントするため（外に作るとコンテナから見えない）
/.selfheal/

# Node
node_modules/

# Web ビルド成果物。rust-embed がコンパイル時にこのフォルダの実体を要求するが、
# ディレクトリの存在保証は scripts/cargo が mkdir -p で行うため git では追跡しない
/web/dist/

# Playwright
/web/test-results/
# compose の検証で使う控えと、ホストで動かすエージェントの置き場所。
# **test-results の下に置けない** — Playwright は走る前にあそこを消すので、
# 立ち上げ側が置いた控えが実行の直前に消える
/web/.e2e-compose/
/web/playwright-report/
/web/.playwright/
# Playwright MCP がブラウザ操作の記録を書き出す先
/.playwright-mcp/
# 出力先を指定し忘れると、スクリーンショットがリポジトリのルートに落ちる。
# 実際にフェーズ5で2枚コミットされていた（本リポジトリは公開）。
# 図版を意図して置くときは png 以外の場所（docs/ 等）を作ってそちらへ入れる
/*.png
/*.jpeg

# ローカル実行時の設定（config.toml.example をコピーして使う）
/config.toml

# 環境変数
.env
.env.*
!.env.example

# ローカルイシューと開発ドキュメント。issue_sync でリモートイシューと同期する運用のため
# git では追跡しない（PJTガイドライン「ローカルイシューのドキュメントを編集するとき」参照）
/MyDocs/

# 配布物を作るときに `dist` がルートへ置く写し（実体は scripts/ にある）。
# 追跡すると、**古い写しを本物と取り違える**経路ができる
/agentdashboard-uninstaller.sh
/agentdashboard-uninstaller.ps1

# OS / エディタ
.DS_Store
*.swp
