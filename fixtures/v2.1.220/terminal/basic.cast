[31.701805, "o", "\u001b[?25l\u001b[2D\u001b[4B\r\u001b[2C\u001b[6A-\u001b[5G追加したドキュメント文字列は日本語で「2つの数値を加算して返す。」という説明です\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m録画用ステータス |\u001b[22GAgentDash\u001b[32Goard\u001b[39m\u001b[K\r\r\n\u001b[3G\u001b[38;2;175;135;255m⏵⏵\u001b[6Gaccept\u001b[13Gedits\u001b[19Gon\u001b[38;2;153;153;153m (shift+tab\u001b[33Gto\u001b[36Gcycle)\u001b[43G·\u001b[45G←\u001b[47Gfor\u001b[51Gagents\u001b[39m\r\r\n\u001b[2C\u001b[4A\u001b[?25h"]
