# AgentDashboard の設定ファイル（設計§12・§17）。
#
# このファイルをリポジトリルートへ `config.toml` としてコピーして使う。
# 全キーに既定値があるため、変えたい項目だけ書けばよい。
# 書かれていないキーは既定値が適用される。知らないキーを書くとエラーになる
# （打ち間違いを黙って無視すると「設定したのに効かない」事故になるため）。
#
# ここに並んでいる値は**すべて既定値**。コメントアウトしてあるものだけは既定が
# 「未指定」なので、値の形が分かるように例として書いてある。
#
# **どのキーも環境変数で上書きできる。** 名前は `AGENTDASHBOARD_<大文字のキー>`
# （例：`AGENTDASHBOARD_PORT=9000`）。ファイルより環境変数が強い。コンテナでは
# 設定ファイルを配らずに環境変数で渡すのが自然なため（設計§14-1）。
# `database_url` と `valkey_url` は慣行に合わせて裸の `DATABASE_URL` /
# `VALKEY_URL` も受ける（両方あるときは `AGENTDASHBOARD_` 付きが勝つ）。

# --- サーバ -------------------------------------------------------------------

# ダッシュボードの待ち受けポート
port = 8787

# 待ち受けるアドレス。既定は 127.0.0.1（外から触れる経路をそもそも作らない）。
# セルフホストのコンテナでは 0.0.0.0 を渡す（設計§14-1）。
# **ローカルモードでここを広げるときは、先に設定画面で LAN パスワードを登録する。**
# 登録せずに広げると起動を拒否する（鍵なしで開ける事故を仕組みで防ぐ。設計§8-3）
bind_addr = "127.0.0.1"

# --- 入口の鍵 -----------------------------------------------------------------

# ログインの Cookie に Secure を付けるか（設計§8-2）。
# Secure を付けた Cookie は HTTPS でしか送られないので、平文で動かす手元や LAN では
# **付けた瞬間にログインできなくなる**。TLS を終端するリバースプロキシの裏に
# 置いたときだけ true にする
cookie_secure = false

# LAN 開放の入館証が切れるまでの時間。切れたらパスワードを入れ直す。
# パスワードは共有の1本なので、入りっぱなしにできると端末を持っている限り
# 誰でも入れる状態が続く。作業のひと区切りより長く、置き忘れた端末が翌日まで
# 生き残らない長さとして 5 時間
lan_session_ttl_hours = 5

# Working のままこの秒数イベントが途絶したら Stalled（停滞）とみなす
stalled_threshold_secs = 120

# --- ターミナル（体感速度の生命線） -------------------------------------------

# PTY 出力をまとめてから WebSocket へ送るまでの窓（ミリ秒）。
# 小さくすると遅延は減るがフレーム数とCPUが増える
coalesce_ms = 8

# セッションごとの scrollback リングバッファ（バイト）。1MiB
pty_ring_buffer = 1048576

# フロー制御のしきい値（バイト）。ブラウザ側の未書き込みバイトが flow_high を
# 超えたら PTY 読み取りを止め、flow_low まで減ったら再開する
flow_high = 262144
flow_low = 32768

# --- 権限モード ---------------------------------------------------------------

# 枠の「＋」で出る権限モードの「既定の選択」を「全承認をスキップ」にするか。
# false のときの既定は「指定なし」。**選択肢はどちらでも3つのまま**で
# （指定なし／編集の承認のみスキップ／全承認をスキップ）、選んだ値は起動のたび既定へ戻る。
# **権限確認を飛ばす設定なので、既定はスキップしない側**にしてある。
#
# ここに書くのは**初期値**。設定画面（/settings）から変えるとサーバの記録が正になり、
# 以後このキーは読まれない（記録を消せばまたここから始まる）。
always_bypass_permissions = false

# --- モデル -------------------------------------------------------------------

# セッションへ statusLine を注入するか。
# これが「いまどのモデルか」を知る唯一の経路（既定のフッタにモデル名は出ないので、
# 端末を読んでも取れない）。切ると画面のモデル表示は「不明」のままになり、
# 切り替えもできなくなる。
# 切れるようにしてあるのは、--settings がコマンドライン引数の層にあるせいで
# **利用者自身の statusLine を上書きしてしまう**ため。自分の statusLine を
# 優先したい場合はここを false にする
inject_status_line = true

# 注入する statusLine の再実行間隔（秒、最小1）。
# statusLine が走る契機に**モデル変更は入っていない**ので、切り替えた結果が画面へ
# 反映されるまでの時間は事実上この値で決まる。
# 1 にするとセッション数だけ毎秒プロセスが起動するので、既定は 3
status_line_refresh_secs = 3

# 利用者のグローバル設定の場所。既定は ~/.claude/settings.json。
# モデルを切り替えると CLI がこのファイルの model キーを書き換えるので、
# ダッシュボードは元の値へ戻す。触るのは model キーだけで、他のキーも並び順も
# インデントも動かさない。
# 差し替えるのはテストと E2E のためで、普段は指定しなくてよい
# claude_settings_path = "/home/you/.claude/settings.json"

# --- 履歴（構造化ビュー） -----------------------------------------------------

# メモリに保持する履歴の直近ウィンドウ（ノード数）。
# 真実は DB にあり、ここは書き抜けを返すための読みキャッシュ。
# これより古い範囲は DB へ問い合わせる（巨大セッションでメモリが破綻しないため）
transcript_window_nodes = 2000

# 履歴ページングの1回あたりの上限（ノード数）
transcript_page_limit = 200

# --- 自己修復 -----------------------------------------------------------------

# 自己修復を動かすか。false にすると検知の通知だけを出し、カナリアも修復セッションも
# 起動しない。**本物の claude を無人で起動して自分のソースを書き換える**機能なので、
# 事情があるときに機能ごと止められるようにしてある
selfheal_enabled = true

# 自己修復のカナリアセッションで使うモデル。
# 対応表が空の初回起動では、いま使っている版すら「知らない版」なのでここが1回走る
canary_model = "haiku"

# カナリアのサンプルが要素不足（ツールコールやサブエージェントが入っていない）
# だったときに、1回だけ採り直すモデル
canary_fallback_model = "sonnet"

# 修復セッションで使うモデル。エイリアスにしてあるのは、CLI 側が「その時点の最新の
# Sonnet」へ解決してくれるため。具体的な版を書くとモデルが新しくなるたびに直すことになる
repair_model = "sonnet"

# 修復の再試行上限
selfheal_retry = 3

# 同一バージョンへの再挑戦を抑制する時間
selfheal_cooldown_hours = 24

# ダッシュボード自身のソースリポジトリ。自己修復はここに git worktree を作り、
# `scripts/cargo` でテストとビルドを行う。未指定なら起動時のカレントディレクトリから
# 上へ辿って探す。見つからなければ自己修復は検知の通知だけに留まる
# selfheal_repo_dir = "/home/you/Dev/AgentDashboard"

# --- 状態の置き場所 -----------------------------------------------------------

# 再開位置・自己修復の対応表・差し替えたパーサを置く場所。
# 未指定なら $XDG_STATE_HOME/agentdashboard（無ければ ~/.local/state/agentdashboard）。
# 一時ディレクトリやビルド成果物の隣に置いてはいけない — 消えると再開位置を失い、
# 起動のたびに全再パースになってブラウザへ履歴が二重に届く
# state_dir = "/home/you/.local/state/agentdashboard"

# 記録（一覧・履歴・設定）の置き場所。
# 未指定なら state_dir の隣に SQLite ファイルを作る。PostgreSQL を使うなら
# postgres://user:pass@host/dbname の形で指定する（スキーマは共通）。
# 消えると一覧と履歴が丸ごと消えるので、state_dir と同じ扱いにすること
# database_url = "sqlite:///home/you/.local/state/agentdashboard/dashboard.db"

# インスタンスの間の連絡係（Valkey）の居場所。
# 未指定なら連絡係を持たず、配信はこのプロセスの中で完結する。ローカルモードと、
# インスタンスが1台だけのセルフホストはこれで足りる。
# 2台以上を並べるなら必須 — 設定し忘れると起動も接続も成功したまま、
# 片方のブラウザにだけ更新が届かない形で「どこへ繋いでも同じ結果」が静かに破れる。
# 接続先に `protocol=resp3` は付けなくてよい（付いていなければ自動で足す）
# valkey_url = "redis://127.0.0.1:6379"

# --- ログ ---------------------------------------------------------------------

# ログは <state_dir>/logs/ に JSON Lines（1行1レコード）で残る。
# 1行が1レコードなので jq で読める。

# ここより古いログを起動時に消す（日）
log_retention_days = 7

# logs/ の**合計**の上限（バイト）。1ファイルの上限ではない。
# 超えていたら古い順に消す。既定は 512 MiB
log_max_bytes = 536870912

# ファイルへ残すレベル。**端末に出る量はこれではなく RUST_LOG で決まる**
log_file_level = "debug"
