# AgentDashboard の設定ファイル（設計§12）。
#
# このファイルをリポジトリルートへ `config.toml` としてコピーして使う。
# 全キーに既定値があるため、変えたい項目だけ書けばよい。
# 書かれていないキーは既定値が適用される。知らないキーを書くとエラーになる
# （打ち間違いを黙って無視すると「設定したのに効かない」事故になるため）。

# ダッシュボードの待ち受けポート。127.0.0.1 のみにバインドする
port = 8787

# Working のままこの秒数イベントが途絶したら Stalled（停滞）とみなす
stalled_threshold_secs = 120

# PTY 出力をまとめてから WebSocket へ送るまでの窓（ミリ秒）。
# 小さくすると遅延は減るがフレーム数とCPUが増える
coalesce_ms = 8

# セッションごとの scrollback リングバッファ（バイト）。1MiB
pty_ring_buffer = 1048576

# フロー制御のしきい値（バイト）。ブラウザ側の未書き込みバイトが flow_high を
# 超えたら PTY 読み取りを止め、flow_low まで減ったら再開する
flow_high = 262144
flow_low = 32768

# 自己修復のカナリアセッションで使うモデル
canary_model = "haiku"

# 修復セッションで使うモデル。コメントアウトのままなら通常モデルを使う
# repair_model = "opus"

# 修復の再試行上限
selfheal_retry = 3

# 同一バージョンへの再挑戦を抑制する時間
selfheal_cooldown_hours = 24
