#!/usr/bin/env bash
# 本物の claude を相手にする統合テスト（テスト計画フェーズ4）を実行する。
#
# 本PJTは cargo をコンテナへ隔離しているが、**本物の claude と認証情報はホストにある**。
# コンテナへ認証情報をマウントするとホスト側の秘密をコンテナへ渡すことになるため、
# 「ビルドはコンテナ、実行はホスト」に分ける。
#
#   1) コンテナで `cargo test --no-run` し、テスト実行ファイルだけを作る
#   2) 出来上がった実行ファイルをホストで動かす（PATH 上の claude を使う）
#
# コンテナのベースは bookworm（glibc 2.36）で、ホストはそれ以降の glibc なので、
# ここで作った実行ファイルはホストでそのまま動く（フェーズ0で検証済み）。
#
# これらのテストは #[ignore] を付けてあるので `make test` では走らない。**本物の claude が
# 起動し、あなたのアカウントのクォータを消費する**ため、明示的に叩いたときだけ実行する。
#
# # 利用者のグローバル設定を退避する
#
# モデルを切り替えると、本物の claude は選択を `~/.claude/settings.json` の `model` へ
# **保存する**（実測。ローカルイシュー「LLMモデル切り替えUI」設計§11 前提3）。
# ダッシュボードは元へ戻すが、テストが途中で落ちたときは戻らない。
#
# 退避と復元を**テストの後始末ではなくここの `trap` に置く**のは、そのため。
# テストが panic しても、Ctrl+C で止めても、必ず戻る。
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# 「コンテナでビルド → ホストで実行」の分業は、本物の claude を相手にする検証すべてに要る。
# 実CLI統合テスト以外（フェーズ0 の PTY 録画など）からも使えるよう、対象を差し替えられる
# ようにしてある。既定は実CLI統合テストのままなので `make test-cli` の挙動は変わらない。
TEST_PACKAGE="${TEST_PACKAGE:-agentdashboard-core}"
TEST_TARGET="${TEST_TARGET:-real_cli}"

if ! command -v claude >/dev/null 2>&1; then
    echo "エラー: 本物の claude が PATH にありません。この検証はホストで実行します。" >&2
    exit 1
fi

# --- 利用者のグローバル設定の退避 --------------------------------------------------
CLAUDE_SETTINGS="${HOME}/.claude/settings.json"
SETTINGS_BACKUP=""
if [[ -f "${CLAUDE_SETTINGS}" ]]; then
    SETTINGS_BACKUP="$(mktemp -t claude-settings-backup-XXXXXX.json)"
    cp "${CLAUDE_SETTINGS}" "${SETTINGS_BACKUP}"
    echo "==> ${CLAUDE_SETTINGS} を退避しました（${SETTINGS_BACKUP}）"
fi

BUILD_LOG="$(mktemp)"

cleanup() {
    rm -f "${BUILD_LOG}"
    # 中身が変わっていたときだけ書き戻す。同じなら触らない（更新時刻を動かさない）
    if [[ -n "${SETTINGS_BACKUP}" && -f "${SETTINGS_BACKUP}" ]]; then
        if ! cmp -s "${SETTINGS_BACKUP}" "${CLAUDE_SETTINGS}" 2>/dev/null; then
            cp "${SETTINGS_BACKUP}" "${CLAUDE_SETTINGS}"
            echo "==> ${CLAUDE_SETTINGS} を元へ戻しました" >&2
        fi
        rm -f "${SETTINGS_BACKUP}"
    fi
}
trap cleanup EXIT

echo "==> テスト実行ファイルをコンテナでビルドします"
"${REPO_ROOT}/scripts/cargo" test \
    --package "${TEST_PACKAGE}" \
    --test "${TEST_TARGET}" \
    --no-run \
    --message-format=json >"${BUILD_LOG}"

# cargo は JSON Lines で成果物を報告する。テスト実行ファイルの場所だけを取り出す。
# 出てくるパスはコンテナ内のもの（/repo/...）なので、ホスト側のパスへ読み替える。
CONTAINER_PATH="$(python3 - "${BUILD_LOG}" "${TEST_TARGET}" <<'PY'
import json, sys

log_path, target_name = sys.argv[1], sys.argv[2]
found = None
with open(log_path, encoding="utf-8") as log:
    for line in log:
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue
        if record.get("reason") != "compiler-artifact":
            continue
        if record.get("target", {}).get("name") != target_name:
            continue
        if record.get("executable"):
            found = record["executable"]

if not found:
    sys.exit(f"テスト実行ファイルが見つかりません（target={target_name}）")
print(found)
PY
)"

HOST_PATH="${REPO_ROOT}${CONTAINER_PATH#/repo}"
if [[ ! -x "${HOST_PATH}" ]]; then
    echo "エラー: ビルドしたテスト実行ファイルが見つかりません: ${HOST_PATH}" >&2
    exit 1
fi

# テストが起動する実行ファイルも要る（どれも実行ファイルの位置から辿って探す）。
#
# - `agentdashboard`：フックが叩く本体と、ペアリングトークンの発行
# - `agentdashboard-agent`：セルフホスト構成の PC 側（フェーズ4 の画面配信）
# - `transcript-parser`：履歴の読み手。**居ないとエージェントが起動時に落ちる**
"${REPO_ROOT}/scripts/cargo" build \
    --package agentdashboard-core --bin agentdashboard \
    --package agentdashboard-agent --bin agentdashboard-agent \
    --package transcript-parser --bin transcript-parser

echo "==> ホストで実行します（本物の claude を起動します）"
# --test-threads=1 にするのは、複数の claude を同時に起動して待ち時間と出力が
# 混ざるのを避けるため。実CLIテストは1本ずつ順番に流す。
#
# **`exec` で置き換えてはいけない。** シェルごと入れ替わるので EXIT の trap が走らず、
# 利用者のグローバル設定が退避したまま戻らない（実際にそうなった）。
# 終了コードは持ち越して、この行の後に trap を走らせる。
STATUS=0
"${HOST_PATH}" --ignored --test-threads=1 --nocapture "$@" || STATUS=$?
exit "${STATUS}"
