#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  --help|-h)
    cat >&2 <<'USAGE'
使い方：violations-recorded [リポジトリルート]
  引数省略時はこのスクリプトの位置からリポジトリルートを自動判定する
  出力：コード側テスト名と DESIGN.md 本文の「違反」「承知のうえで」記載を標準出力へ列挙
終了コード：0=成功 / 1=ROOT または DESIGN.md が見つからない
USAGE
    exit 0
    ;;
esac

ROOT="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)}"
DESIGN_MD="${DESIGN_MD:-$ROOT/DESIGN.md}"

if [[ ! -d "$ROOT" ]]; then
  echo "エラー：リポジトリルートが見つかりません：$ROOT" >&2
  exit 1
fi

if [[ ! -f "$DESIGN_MD" ]]; then
  echo "エラー：DESIGN.md が見つかりません：$DESIGN_MD" >&2
  exit 1
fi

echo "## コード側（web/src/**/*.test.ts* のテスト名）"
if [[ -d "$ROOT/web/src" ]]; then
  grep -rnE "(it|test)\(['\"].*(違反|床を割|承知のうえ)" \
    "$ROOT/web/src" \
    --include='*.test.ts' --include='*.test.tsx' \
    || echo "（該当なし）"
else
  echo "（web/src が見つかりません：$ROOT/web/src）"
fi

echo ""
echo "## DESIGN.md 本文側"
grep -nE "(違反|承知のうえで)" "$DESIGN_MD" || echo "（該当なし）"
