#!/usr/bin/env bash
set -u -o pipefail

usage() {
  cat >&2 <<'USAGE'
使い方：
  ship --version <版> [--dry-run] [--repo <パス>]

  --version    上げる版番号（例：0.1.199）。必須
  --dry-run    実行はせず、実行するコマンド列を表示するだけ
  --repo       対象リポジトリのパス（省略時はこのスクリプトから辿った既定の場所）
終了コード：0 正常 / 1 commit・push・tag のいずれかが失敗 / 2 タグが既に存在 / 5 commit に想定外のファイルが載った / 64 引数が不正

警告：コミット・タグ・push を行う（公開リポジトリへ出る）。--dry-run でコマンドだけ見られる
USAGE
}

repo=""
dry_run=0
version=""

while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --repo)
      repo="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --version)
      version="$2"
      shift 2
      ;;
    *)
      echo "ship: unknown argument: $1" >&2
      exit 64
      ;;
  esac
done

if [ -z "$version" ]; then
  echo "ship: --version は必須です" >&2
  exit 64
fi

if ! printf '%s' "$version" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "ship: --version の形式が不正です: $version" >&2
  exit 64
fi

if [ -z "$repo" ]; then
  script_dir="$(cd "$(dirname "$0")" && pwd)"
  repo="$(cd "$script_dir/../../../.." && pwd)"
fi

tag="v${version}"

if git -C "$repo" rev-parse --verify --quiet "refs/tags/${tag}" >/dev/null 2>&1; then
  echo "ship: タグ ${tag} は既に存在します" >&2
  exit 2
fi

files=(server/Cargo.toml docker/compose.yml server/Cargo.lock CHANGELOG.md)

expected_subject="chore(release): ${version}"
commit_cmd=(git -C "$repo" commit --only -m "${expected_subject}" -- "${files[@]}")
tag_cmd=(git -C "$repo" tag "${tag}")
push_main_cmd=(git -C "$repo" push origin main)
push_tag_cmd=(git -C "$repo" push origin "${tag}")

head_subject="$(git -C "$repo" log -1 --format=%s 2>/dev/null)"
skip_commit=0
if [ "$head_subject" = "$expected_subject" ] \
  && git -C "$repo" diff --quiet -- "${files[@]}" \
  && git -C "$repo" diff --cached --quiet -- "${files[@]}"; then
  skip_commit=1
fi

if [ "$dry_run" -eq 1 ]; then
  if [ "$skip_commit" -eq 0 ]; then
    printf '%q ' "${commit_cmd[@]}"; echo
  fi
  printf '%q ' "${push_main_cmd[@]}"; echo
  printf '%q ' "${tag_cmd[@]}"; echo
  printf '%q ' "${push_tag_cmd[@]}"; echo
  exit 0
fi

if [ "$skip_commit" -eq 0 ]; then
  if ! "${commit_cmd[@]}"; then
    echo "ship: commit が失敗した" >&2
    exit 1
  fi

  head_subject="$(git -C "$repo" log -1 --format=%s)"
  if [ "$head_subject" != "$expected_subject" ]; then
    echo "ship: commit 後の HEAD が想定と違う（期待：${expected_subject} ／実際：${head_subject}）" >&2
    exit 1
  fi

  mapfile -t shown_files < <(git -C "$repo" show --stat --name-only --format= HEAD | grep -v '^$')
  extra_files=()
  for shown in "${shown_files[@]}"; do
    matched=0
    for expected in "${files[@]}"; do
      if [ "$shown" = "$expected" ]; then
        matched=1
        break
      fi
    done
    if [ "$matched" -eq 0 ]; then
      extra_files+=("$shown")
    fi
  done

  if [ "${#shown_files[@]}" -ne "${#files[@]}" ] || [ "${#extra_files[@]}" -gt 0 ]; then
    echo "ship: commit に想定外のファイルが載った：${extra_files[*]}" >&2
    exit 5
  fi
fi

if ! "${push_main_cmd[@]}"; then
  echo "ship: push origin main が失敗した（tag はまだ作っていない）" >&2
  exit 1
fi

if ! "${tag_cmd[@]}"; then
  echo "ship: tag が失敗した" >&2
  exit 1
fi

if ! "${push_tag_cmd[@]}"; then
  echo "ship: push origin ${tag} が失敗した" >&2
  exit 1
fi
