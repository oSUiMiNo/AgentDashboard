#!/usr/bin/env bash
set -u -o pipefail

repo=""
dry_run=0
version=""

while [ $# -gt 0 ]; do
  case "$1" in
    --repo)
      repo="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --version)
      version="$2"
      shift 2
      ;;
    *)
      echo "ship: unknown argument: $1" >&2
      exit 64
      ;;
  esac
done

if [ -z "$version" ]; then
  echo "ship: --version は必須です" >&2
  exit 64
fi

if ! printf '%s' "$version" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "ship: --version の形式が不正です: $version" >&2
  exit 64
fi

if [ -z "$repo" ]; then
  script_dir="$(cd "$(dirname "$0")" && pwd)"
  repo="$(cd "$script_dir/../../../.." && pwd)"
fi

tag="v${version}"

if git -C "$repo" rev-parse --verify --quiet "refs/tags/${tag}" >/dev/null 2>&1; then
  echo "ship: タグ ${tag} は既に存在します" >&2
  exit 2
fi

files=(server/Cargo.toml docker/compose.yml server/Cargo.lock CHANGELOG.md)

add_cmd=(git -C "$repo" add "${files[@]}")
commit_cmd=(git -C "$repo" commit -m "chore(release): ${version}")
tag_cmd=(git -C "$repo" tag "${tag}")
push_main_cmd=(git -C "$repo" push origin main)
push_tag_cmd=(git -C "$repo" push origin "${tag}")

if [ "$dry_run" -eq 1 ]; then
  printf '%q ' "${add_cmd[@]}"; echo
  printf '%q ' "${commit_cmd[@]}"; echo
  printf '%q ' "${tag_cmd[@]}"; echo
  printf '%q ' "${push_main_cmd[@]}"; echo
  printf '%q ' "${push_tag_cmd[@]}"; echo
  exit 0
fi

"${add_cmd[@]}"
"${commit_cmd[@]}"
"${tag_cmd[@]}"
"${push_main_cmd[@]}"
"${push_tag_cmd[@]}"
