#!/usr/bin/env bash
set -u -o pipefail

repo=""
dry_run=0
version_arg=""
force=0

while [ $# -gt 0 ]; do
  case "$1" in
    --repo)
      repo="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --version)
      version_arg="$2"
      shift 2
      ;;
    --force)
      force=1
      shift
      ;;
    *)
      echo "bump: unknown argument: $1" >&2
      exit 64
      ;;
  esac
done

if [ -n "$version_arg" ] && ! printf '%s' "$version_arg" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "bump: --version の形式が不正です: $version_arg" >&2
  exit 64
fi

if [ -z "$repo" ]; then
  script_dir="$(cd "$(dirname "$0")" && pwd)"
  repo="$(cd "$script_dir/../../../.." && pwd)"
fi

cargo_toml="$repo/server/Cargo.toml"
compose_yml="$repo/docker/compose.yml"
cargo_lock="$repo/server/Cargo.lock"
changelog="$repo/CHANGELOG.md"

for f in "$cargo_toml" "$compose_yml" "$cargo_lock" "$changelog"; do
  if [ ! -f "$f" ]; then
    echo "bump: ファイルが見つかりません: $f" >&2
    exit 1
  fi
done

dirty="$(git -C "$repo" status --porcelain -- "$cargo_toml" "$compose_yml" "$cargo_lock" "$changelog" 2>/dev/null)"
if [ -n "$dirty" ]; then
  dirty_paths="$(printf '%s\n' "$dirty" | awk '{print $2}' | paste -sd '、' -)"
  if [ "$dry_run" -eq 1 ]; then
    echo "bump: 他セッションが触っている可能性：${dirty_paths}（--dry-run のため続行）" >&2
  elif [ "$force" -eq 1 ]; then
    echo "bump: 他セッションが触っている可能性：${dirty_paths}（--force のため続行）" >&2
  else
    echo "bump: 他セッションが触っている可能性：${dirty_paths}。shared-tree_commit で切り分けるか、相手の作業が終わるのを待つ" >&2
    exit 4
  fi
fi

toml_line_no="$(grep -n '^version = "' "$cargo_toml" | head -1 | cut -d: -f1)"
if [ -z "$toml_line_no" ]; then
  echo "bump: server/Cargo.toml に version 行が見つかりません" >&2
  exit 1
fi
current_version="$(sed -n "${toml_line_no}p" "$cargo_toml" | sed -E 's/^version = "([^"]+)".*/\1/')"

if [ -n "$version_arg" ]; then
  new_version="$version_arg"
else
  IFS='.' read -r major minor patch <<<"$current_version"
  new_version="${major}.${minor}.$((patch + 1))"
fi

compose_line_no="$(grep -n 'image: ghcr.io/osuimino/agentdashboard:' "$compose_yml" | head -1 | cut -d: -f1)"
if [ -z "$compose_line_no" ]; then
  echo "bump: docker/compose.yml に image 行が見つかりません" >&2
  exit 1
fi
old_compose_version="$(sed -n "${compose_line_no}p" "$compose_yml" | sed -E 's/.*agentdashboard:([0-9]+\.[0-9]+\.[0-9]+).*/\1/')"

lock_name_line_no="$(grep -n '^name = "agentdashboard"$' "$cargo_lock" | head -1 | cut -d: -f1)"
if [ -z "$lock_name_line_no" ]; then
  echo "bump: server/Cargo.lock に agentdashboard の name 行が見つかりません" >&2
  exit 1
fi
lock_version_line_no=$((lock_name_line_no + 1))
old_lock_version="$(sed -n "${lock_version_line_no}p" "$cargo_lock" | sed -E 's/^version = "([^"]+)".*/\1/')"

lock_version_lines="$(awk '
  /^\[\[package\]\]$/ {
    if (pending > 0 && !hassrc) print pending
    pending = 0; hassrc = 0; next
  }
  /^version = "/ { if (pending == 0) pending = NR }
  /^source = / { hassrc = 1 }
  END { if (pending > 0 && !hassrc) print pending }
' "$cargo_lock")"
if [ -z "$lock_version_lines" ]; then
  echo "bump: server/Cargo.lock に workspace メンバの version 行が見つかりません" >&2
  exit 1
fi
lock_member_count="$(printf '%s\n' "$lock_version_lines" | grep -c '.')"

last_tag="$(git -C "$repo" describe --tags --abbrev=0 --match 'v*' 2>/dev/null)"
commit_titles=""
if [ -n "$last_tag" ]; then
  commit_titles="$(git -C "$repo" log "${last_tag}..HEAD" --pretty=format:'%s' 2>/dev/null)"
fi

block_tmp="$(mktemp)"
{
  printf '## %s\n' "$new_version"
  printf '\n'
  printf '**（触って何が変わるかを1文で）**\n'
  printf '\n'
  if [ -n "$commit_titles" ]; then
    while IFS= read -r title; do
      [ -z "$title" ] && continue
      if printf '%s' "$title" | grep -qE 'crate|fn|\.rs|\.ts|web/|server/|test\(|chore\('; then
        printf '<!-- 実装語 --> - %s\n' "$title"
      else
        printf -- '- %s\n' "$title"
      fi
    done <<<"$commit_titles"
  fi
  printf '\n'
} >"$block_tmp"

if [ "$dry_run" -eq 1 ]; then
  echo "[server/Cargo.toml]"
  echo "- version = \"$current_version\""
  echo "+ version = \"$new_version\""
  echo
  echo "[docker/compose.yml]"
  echo "- image: ghcr.io/osuimino/agentdashboard:$old_compose_version"
  echo "+ image: ghcr.io/osuimino/agentdashboard:$new_version"
  echo
  echo "[server/Cargo.lock]"
  echo "- version = \"$old_lock_version\" (workspace メンバ ${lock_member_count} 件)"
  echo "+ version = \"$new_version\" (workspace メンバ ${lock_member_count} 件)"
  echo
  echo "[CHANGELOG.md]"
  cat "$block_tmp"
  rm -f "$block_tmp"
  exit 0
fi

sed -i "${toml_line_no}s/.*/version = \"$new_version\"/" "$cargo_toml"
sed -i "${compose_line_no}s/agentdashboard:${old_compose_version}/agentdashboard:${new_version}/" "$compose_yml"

lock_tmp="$(mktemp)"
awk -v newv="$new_version" -v lines="$lock_version_lines" '
  BEGIN {
    n = split(lines, arr, "\n")
    for (i = 1; i <= n; i++) target[arr[i]] = 1
  }
  {
    if (NR in target) sub(/version = ".*"/, "version = \"" newv "\"")
    print
  }
' "$cargo_lock" >"$lock_tmp" && mv "$lock_tmp" "$cargo_lock"

first_heading_line="$(grep -n '^## ' "$changelog" | head -1 | cut -d: -f1)"
if [ -z "$first_heading_line" ]; then
  echo "bump: CHANGELOG.md に ## 見出しが見つかりません" >&2
  rm -f "$block_tmp"
  exit 1
fi

changelog_tmp="$(mktemp)"
awk -v n="$first_heading_line" -v blockfile="$block_tmp" '
  NR==n {
    while ((getline line < blockfile) > 0) print line
  }
  { print }
' "$changelog" >"$changelog_tmp" && mv "$changelog_tmp" "$changelog"
rm -f "$block_tmp"

echo "bump: ${current_version} -> ${new_version}"
