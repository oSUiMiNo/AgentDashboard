#!/usr/bin/env bash
set -u -o pipefail

usage() {
  cat >&2 <<'USAGE'
使い方：
  build-live [--dry-run]

  --dry-run    実行はせず、実行するコマンド列を表示するだけ
終了コード：0 正常 / 1 pull または build が失敗 / 3 札の仕組みが無い、または複数あって決められない

警告：実機ツリー（~/AgentDashboard）で git pull と make build を実行する。--dry-run でコマンドだけ見られる
USAGE
}

dry_run=0
while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    *)
      echo "build-live: unknown argument: $1" >&2
      exit 64
      ;;
  esac
done

script_dir="$(cd "$(dirname "$0")" && pwd)"
claim_bin="$(cd "$script_dir/../../_shared/bin" && pwd)/claim"
live_tree="$HOME/AgentDashboard"

session_id="${CLAUDE_SESSION_ID:-nosession}"
identity="${session_id:0:8}-build-live"
lock_key="__重いテスト__"
reason="版上げの実機ビルド"

if [ "$dry_run" -eq 1 ]; then
  echo "$claim_bin $identity take $lock_key \"$reason\""
  echo "git -C $live_tree pull --ff-only"
  echo "make -C $live_tree build"
  echo "$claim_bin $identity free $lock_key"
  exit 0
fi

"$claim_bin" "$identity" take "$lock_key" "$reason"
claim_status=$?
if [ "$claim_status" -eq 1 ]; then
  echo "build-live: $lock_key を他セッションが握っている。待つか、その相手へ頼む" >&2
  exit 1
fi
if [ "$claim_status" -eq 3 ]; then
  echo "build-live: 札の仕組みが無い（または複数あって決められない）" >&2
  exit 3
fi
if [ "$claim_status" -ne 0 ]; then
  echo "build-live: claim take が失敗（終了 $claim_status）" >&2
  exit "$claim_status"
fi

release_lock() {
  "$claim_bin" "$identity" free "$lock_key" >/dev/null 2>&1
}
trap release_lock EXIT
trap 'release_lock; exit 130' INT
trap 'release_lock; exit 143' TERM

build_status=0
if ! git -C "$live_tree" pull --ff-only; then
  build_status=1
fi
if [ "$build_status" -eq 0 ]; then
  if ! make -C "$live_tree" build; then
    build_status=1
  fi
fi

"$claim_bin" "$identity" free "$lock_key"

exit "$build_status"
