#!/usr/bin/env python3
import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

MATERIAL_NAMES = {"参考", "調査レポート", "証拠", "スクショ", "サンプル生成"}
BUNDLE_DATE_RE = re.compile(r"イシューグループ_(\d{4}-\d{4}-\d{4})")

DEFAULT_ISSUES_DIR = Path(__file__).resolve().parents[4] / "MyDocs" / "イシュー"


def list_top_dirs(path: Path):
    if not path.is_dir():
        return []
    r = subprocess.run(
        ["find", str(path), "-mindepth", "1", "-maxdepth", "1", "-type", "d", "-print0"],
        capture_output=True,
        check=True,
    )
    names = []
    for p in r.stdout.split(b"\0"):
        if p:
            names.append(Path(p.decode("utf-8")).name)
    return sorted(names)


def is_material(name: str) -> bool:
    return name in MATERIAL_NAMES or name.startswith("_")


def is_bundle(name: str) -> bool:
    return name.startswith("イシューグループ_")


def real_standalone_names(issue_root: Path):
    out = []
    for n in list_top_dirs(issue_root):
        if n == "クローズ":
            continue
        if is_bundle(n) or is_material(n):
            continue
        out.append(n)
    return out


def real_bundle_names(issue_root: Path):
    return [n for n in list_top_dirs(issue_root) if is_bundle(n)]


def real_bundle_members(issue_root: Path, bundle_name: str):
    bp = issue_root / bundle_name
    out = []
    for n in list_top_dirs(bp):
        if n == "クローズ" or is_material(n):
            continue
        out.append(n)
    return out


def real_closed_names(issue_root: Path):
    closed_root = issue_root / "クローズ"
    names = set()
    for n in list_top_dirs(closed_root):
        if is_material(n):
            continue
        names.add(n)
        if is_bundle(n):
            for child in list_top_dirs(closed_root / n):
                if child == "クローズ" or is_material(child):
                    continue
                names.add(child)
    return names


def get_section(data, sid):
    for s in data.get("sections", []):
        if s.get("id") == sid:
            return s
    return None


def strip_md(s: str) -> str:
    return re.sub(r"\*\*|`", "", s or "").strip()


def table_blocks(section):
    if not section:
        return []
    return [b for b in section.get("blocks", []) if b.get("type") == "table"]


def all_row_names(section):
    names = set()
    for b in table_blocks(section):
        for row in b.get("rows", []):
            if row:
                names.add(strip_md(row[0]))
    return names


def extract_count(title: str):
    if not title:
        return None
    m = re.search(r"\d+", title)
    return int(m.group(0)) if m else None


def bundle_date_key(bundle_folder_name: str):
    m = BUNDLE_DATE_RE.match(bundle_folder_name)
    return m.group(1) if m else None


def find_bundle_table(s03_section, bundle_folder_name):
    key = bundle_date_key(bundle_folder_name)
    if not key or not s03_section:
        return None
    blocks = s03_section.get("blocks", [])
    for i, b in enumerate(blocks):
        if b.get("type") == "h3" and b.get("text", "").startswith(key):
            for b2 in blocks[i + 1 :]:
                if b2.get("type") == "h3":
                    break
                if b2.get("type") == "table":
                    return b2
    return None


def find_or_create_catchall_table(s04_section):
    blocks = s04_section.setdefault("blocks", [])
    for i, b in enumerate(blocks):
        if b.get("type") == "h3" and "未分類" in b.get("text", ""):
            for b2 in blocks[i + 1 :]:
                if b2.get("type") == "h3":
                    break
                if b2.get("type") == "table":
                    return b2
    blocks.append({"type": "h3", "text": "（未分類・map-check 自動追加）"})
    table = {"type": "table", "head": ["イシュー", "何を求めているか", "いまの状態"], "rows": []}
    blocks.append(table)
    return table


def update_title_count(section, real_count):
    if section is None or real_count is None:
        return False
    title = section.get("title", "")
    old = extract_count(title)
    if old == real_count:
        return False
    new_title = re.sub(r"\d+", str(real_count), title, count=1)
    section["title"] = new_title
    return True


def remove_row_by_name(section, name):
    if not section:
        return False
    for b in table_blocks(section):
        rows = b.get("rows", [])
        for i, row in enumerate(rows):
            if row and strip_md(row[0]) == name:
                del rows[i]
                return True
    return False


def run_check(data, issue_root: Path):
    s03 = get_section(data, "s03")
    s04 = get_section(data, "s04")
    real_bundles = real_bundle_names(issue_root)
    real_standalone = real_standalone_names(issue_root)
    result = {"missing": [], "closed_but_open": [], "count_mismatch": []}

    json_bundle_n = extract_count(s03.get("title", "")) if s03 else None
    json_standalone_n = extract_count(s04.get("title", "")) if s04 else None
    if json_bundle_n is not None and json_bundle_n != len(real_bundles):
        result["count_mismatch"].append({"section": "s03", "json": json_bundle_n, "real": len(real_bundles)})
    if json_standalone_n is not None and json_standalone_n != len(real_standalone):
        result["count_mismatch"].append({"section": "s04", "json": json_standalone_n, "real": len(real_standalone)})

    s03_names = all_row_names(s03)
    s04_names = all_row_names(s04)

    for n in real_standalone:
        if n not in s04_names:
            result["missing"].append({"section": "s04", "name": n})

    bundle_members = {}
    for b in real_bundles:
        members = real_bundle_members(issue_root, b)
        bundle_members[b] = members
        for m in members:
            if m not in s03_names:
                result["missing"].append({"section": "s03", "bundle": b, "name": m})

    closed = real_closed_names(issue_root)
    for n in closed:
        if n in s03_names:
            result["closed_but_open"].append({"section": "s03", "name": n})
        if n in s04_names:
            result["closed_but_open"].append({"section": "s04", "name": n})

    return result, bundle_members, len(real_bundles), len(real_standalone)


def apply_fix(data, result, real_bundle_n, real_standalone_n):
    s03 = get_section(data, "s03")
    s04 = get_section(data, "s04")
    fixed = 0
    unfixable = 0

    for m in result["missing"]:
        if m["section"] == "s04":
            table = find_or_create_catchall_table(s04)
            table["rows"].append([m["name"], "（未記入）", "（未記入）"])
            fixed += 1
        else:
            table = find_bundle_table(s03, m["bundle"])
            if table is not None:
                table["rows"].append([m["name"], "（未記入）", "（未記入）"])
                fixed += 1
            else:
                unfixable += 1

    for c in result["closed_but_open"]:
        section = s03 if c["section"] == "s03" else s04
        if remove_row_by_name(section, c["name"]):
            fixed += 1
        else:
            unfixable += 1

    if update_title_count(s03, real_bundle_n):
        fixed += 1
    if update_title_count(s04, real_standalone_n):
        fixed += 1

    return fixed, unfixable


def print_report(result, real_bundle_n, real_standalone_n, fix_stats=None):
    print(f"束：実物 {real_bundle_n} 件／単独：実物 {real_standalone_n} 件")
    print(f"件数不一致：{len(result['count_mismatch'])} 件")
    for c in result["count_mismatch"]:
        print(f"  {c['section']}：JSON={c['json']} 実物={c['real']}")
    print(f"行が無い（見取り図に載っていない）：{len(result['missing'])} 件")
    for m in result["missing"]:
        loc = m["section"] + (f"（束：{m['bundle']}）" if m.get("bundle") else "")
        print(f"  {loc}：{m['name']}")
    print(f"閉じたのに開いたまま載っている：{len(result['closed_but_open'])} 件")
    for c in result["closed_but_open"]:
        print(f"  {c['section']}：{c['name']}")
    if fix_stats is not None:
        fixed, unfixable = fix_stats
        print(f"--fix：{fixed} 件を直した／{unfixable} 件は要約を書けないので直せなかった")


def main():
    ap = argparse.ArgumentParser(description="_イシューの見取り図 の s03/s04 と実フォルダを突き合わせる")
    ap.add_argument("--json", required=True, help="見取り図 JSON のパス")
    ap.add_argument("--html", help="見取り図 HTML のパス（--fix 時、render.py の出力先に使う）")
    ap.add_argument(
        "--issues-dir",
        default=None,
        help="実イシューの列挙元ルート（既定：スクリプトの位置から辿った PJT の MyDocs/イシュー）",
    )
    ap.add_argument(
        "--render",
        default=str(Path.home() / ".claude/skills/understanding-doc_write/assets/code/render.py"),
        help="render.py のパス",
    )
    ap.add_argument("--fix", action="store_true", help="機械的に判定できる差分だけを直し、render.py で HTML を作り直す")
    ap.add_argument("--json-out", action="store_true", help="結果を JSON で出す")
    args = ap.parse_args()

    try:
        json_path = Path(args.json).resolve()
        issue_root = Path(args.issues_dir).resolve() if args.issues_dir else DEFAULT_ISSUES_DIR
        data = json.loads(json_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as e:
        print(f"エラー：見取り図 JSON が読めない：{e}", file=sys.stderr)
        return 2

    result, _bundle_members, real_bundle_n, real_standalone_n = run_check(data, issue_root)

    fix_stats = None
    if args.fix:
        fixed, unfixable = apply_fix(data, result, real_bundle_n, real_standalone_n)
        fix_stats = (fixed, unfixable)
        json_path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        if args.html:
            render = subprocess.run(
                ["python3", args.render, str(json_path), "-o", args.html],
                capture_output=True,
                text=True,
            )
            if render.returncode != 0:
                print(render.stderr, file=sys.stderr)
                print("警告：render.py が失敗した。HTML は作り直されていない。", file=sys.stderr)
                return 2
            print(render.stdout.strip())

    has_discrepancy = bool(result["missing"] or result["closed_but_open"] or result["count_mismatch"])

    if args.json_out:
        out = dict(result)
        out["real_bundle_count"] = real_bundle_n
        out["real_standalone_count"] = real_standalone_n
        if fix_stats is not None:
            out["fixed"], out["unfixable"] = fix_stats
        print(json.dumps(out, ensure_ascii=False, indent=2))
    else:
        print_report(result, real_bundle_n, real_standalone_n, fix_stats)

    return 1 if has_discrepancy else 0


if __name__ == "__main__":
    raise SystemExit(main())
