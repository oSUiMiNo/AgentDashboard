#!/usr/bin/env python3
import argparse
import json
import re
import sys
from datetime import datetime
from pathlib import Path

DATE_RE = re.compile(r"(\d{4})-(\d{2})(\d{2})-(\d{2})(\d{2})")


def find_proposal_files(root: Path):
    files = []
    direct = root / ".claude" / "skills" / "PROPOSAL.md"
    if direct.is_file():
        files.append(direct)
    skills_dir = root / ".claude" / "skills"
    if skills_dir.is_dir():
        for p in sorted(skills_dir.glob("*/PROPOSAL.md")):
            files.append(p)
    return files


def split_table_row(line: str):
    return [c.strip() for c in line.strip().strip("|").split("|")]


def is_separator_row(cells):
    return all(set(c) <= set("-: ") and c != "" for c in cells)


def parse_overview_table(text: str):
    lines = text.splitlines()
    in_section = False
    header = None
    rows = []
    for line in lines:
        s = line.strip()
        if s.startswith("## 概要表"):
            in_section = True
            continue
        if in_section and s.startswith("## "):
            break
        if not in_section or not s.startswith("|"):
            continue
        cells = split_table_row(line)
        if header is None:
            header = cells
            continue
        if is_separator_row(cells):
            continue
        rows.append(cells)
    return header, rows


def elapsed_days(added_at: str, now: datetime):
    m = DATE_RE.match(added_at or "")
    if not m:
        return None
    y, mo, d, h, mi = (int(x) for x in m.groups())
    try:
        dt = datetime(y, mo, d, h, mi)
    except ValueError:
        return None
    return (now - dt).days


def collect(root: Path, now: datetime):
    out_rows = []
    for f in find_proposal_files(root):
        text = f.read_text(encoding="utf-8")
        header, rows = parse_overview_table(text)
        if header is None:
            continue
        idx = {name: i for i, name in enumerate(header)}

        def get(cells, col, default=""):
            i = idx.get(col)
            return cells[i] if i is not None and i < len(cells) else default

        for cells in rows:
            added = get(cells, "追加日時")
            out_rows.append(
                {
                    "ファイル": str(f.relative_to(root)),
                    "#": get(cells, "#"),
                    "状態": get(cells, "完了ステータス"),
                    "追加日時": added,
                    "要約": get(cells, "要約"),
                    "経過日数": elapsed_days(added, now),
                }
            )
    return out_rows


def print_table(rows):
    if not rows:
        print("PROPOSAL.md の行は見つからなかった。")
        return
    cols = ["ファイル", "#", "状態", "追加日時", "要約", "経過日数"]
    widths = {c: len(c) for c in cols}
    for r in rows:
        for c in cols:
            widths[c] = max(widths[c], len(str(r[c])))

    def fmt(vals):
        return " | ".join(str(v).ljust(widths[c]) for c, v in zip(cols, vals))

    print(fmt(cols))
    print("-+-".join("-" * widths[c] for c in cols))
    for r in rows:
        print(fmt([r[c] for c in cols]))


def main():
    ap = argparse.ArgumentParser(description="PROPOSAL.md を集めて一覧化する（読むだけ）")
    ap.add_argument("--root", default=".", help="PJT ルート（既定：カレントディレクトリ）")
    ap.add_argument("--json", action="store_true", help="JSON で出力する")
    ap.add_argument("--now", help="経過日数の基準時刻（ISO8601。省略時は現在時刻）")
    args = ap.parse_args()

    root = Path(args.root).resolve()
    if not root.is_dir():
        print(f"エラー：ルートが見つからない：{root}", file=sys.stderr)
        return 2
    now = datetime.fromisoformat(args.now) if args.now else datetime.now()

    rows = collect(root, now)
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
    else:
        print_table(rows)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
